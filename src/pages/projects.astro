---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = (await getCollection("projects")).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.title.localeCompare(b.data.title);
});
---

<BaseLayout
  title="Projects"
  description="Open-source hardware and software projects — built because of problems, shared because open source is a philosophy."
>
  <section class="grid-bg border-b border-edge">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <p class="font-mono text-sm text-phosphor-dim">
        <span class="text-poke">~/</span>projects<span class="cursor ml-1"></span>
      </p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        Open source, <span class="text-phosphor glow">first</span>
      </h1>
      <p class="mt-4 max-w-2xl text-ink-dim">
        Tools, firmware and games built to solve real problems. Every one of
        them is free to use, study and improve. Grab the source, break it, fix
        it, and send a pull request.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-5 md:grid-cols-2">
      {projects.map((p) => (
        <div class="flex flex-col rounded-lg border border-edge bg-panel p-6 transition-colors hover:border-phosphor/60">
          <div class="flex items-start justify-between gap-3">
            <h2 class="font-display text-lg font-semibold text-ink">{p.data.title}</h2>
            <Icon name="lucide:git-fork" class="h-4 w-4 shrink-0 text-phosphor-dim" />
          </div>
          <p class="mt-2 text-sm leading-relaxed text-ink-dim">{p.data.description}</p>

          {p.data.tech.length > 0 && (
            <div class="mt-4 flex flex-wrap gap-1.5">
              {p.data.tech.map((t) => (
                <span class="rounded border border-edge bg-night px-2 py-0.5 font-mono text-xs text-ink-faint">{t}</span>
              ))}
            </div>
          )}

          <div class="mt-5 flex items-center gap-3 border-t border-edge pt-4">
            <a
              href={p.data.repo}
              target="_blank"
              rel="noopener"
              class="inline-flex items-center gap-1.5 text-sm text-phosphor hover:text-phosphor-bright"
            >
              <Icon name="lucide:github" class="h-4 w-4" />
              Source
            </a>
            {p.data.demo && (
              <a
                href={p.data.demo}
                target="_blank"
                rel="noopener"
                class="inline-flex items-center gap-1.5 text-sm text-ink-dim hover:text-phosphor"
              >
                <Icon name="lucide:external-link" class="h-4 w-4" />
                Demo
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="border-t border-edge bg-night/50">
    <div class="mx-auto max-w-6xl px-4 py-16 text-center sm:px-6">
      <h2 class="font-display text-2xl font-bold text-ink">Want to get involved?</h2>
      <p class="mx-auto mt-3 max-w-xl text-ink-dim">
        These projects live on GitHub. If one of them solves a problem for you,
        star it, fork it, or start a discussion — building together is the whole
        point.
      </p>
      <a
        href="https://github.com/sudobreakstuff"
        target="_blank"
        rel="noopener"
        class="mt-6 inline-flex items-center gap-2 rounded border border-phosphor bg-phosphor/10 px-6 py-3 text-sm font-semibold text-phosphor transition-colors hover:bg-phosphor hover:text-void"
      >
        <Icon name="lucide:github" class="h-4 w-4" />
        github.com/sudobreakstuff
      </a>
    </div>
  </section>
</BaseLayout>
