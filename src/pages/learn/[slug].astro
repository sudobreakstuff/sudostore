---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import { BASE } from "../../lib/site";

export async function getStaticPaths() {
  const posts = await getCollection("learn", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, level, tags, published } = post.data;

const allPosts = (await getCollection("learn", ({ data }) => !data.draft))
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());

const tagSet = new Set(tags);
const relatedGuides = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => ({
    p,
    overlap: (p.data.tags ?? []).filter((t) => tagSet.has(t)).length,
  }))
  .filter((x) => x.overlap > 0)
  .sort((a, b) => b.overlap - a.overlap)
  .slice(0, 3)
  .map((x) => x.p);
const fallbackGuides = allPosts.filter((p) => p.id !== post.id).slice(0, 3);
const readNext = relatedGuides.length >= 2 ? relatedGuides : fallbackGuides.slice(0, 3);

const allProducts = (await getCollection("products")).filter((p) =>
  (p.data.tags ?? []).some((t) => tagSet.has(t))
);
const relatedProducts =
  allProducts.length > 0 ? allProducts.slice(0, 3) : (await getCollection("products")).filter((p) => p.data.featured).slice(0, 3);

const levelStyles: Record<string, string> = {
  beginner: "text-neon border-neon/40",
  intermediate: "text-neon-bright border-neon/40",
  advanced: "text-red-bright border-red/40",
};
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <a href={`${BASE}learn/`} class="inline-flex items-center gap-1.5 text-sm text-ink-dim hover:text-neon">
      <Icon name="lucide:arrow-left" class="h-4 w-4" />
      All guides
    </a>

    <header class="mt-8">
      <div class="flex flex-wrap items-center gap-3">
        <span class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs ${levelStyles[level] ?? levelStyles.beginner}`}>
          {level}
        </span>
        <time class="font-mono text-xs text-ink-faint">
          {published.toLocaleDateString("en-ZA", { year: "numeric", month: "long", day: "numeric" })}
        </time>
      </div>
      <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-ink">{title}</h1>
      <p class="mt-3 text-lg text-ink-dim">{description}</p>
    </header>

    <div class="article mt-10">
      <Content />
    </div>

    {tags.length > 0 && (
      <div class="mt-12 flex flex-wrap gap-2 border-t border-edge pt-6">
        {tags.map((tag) => (
          <span class="rounded border border-edge bg-panel px-2 py-1 font-mono text-xs text-ink-faint">#{tag}</span>
        ))}
      </div>
    )}

    {relatedProducts.length > 0 && (
      <div class="mt-14 border-t border-edge pt-10">
        <h2 class="font-mono text-sm uppercase tracking-widest text-ink-dim">
          <span class="text-red">$</span> ./shop-this-guide
        </h2>
        <p class="mt-2 text-sm text-ink-dim">Built, tested and ready to go on this site.</p>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {relatedProducts.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    )}

    {readNext.length > 0 && (
      <div class="mt-14 border-t border-edge pt-10">
        <h2 class="font-mono text-sm uppercase tracking-widest text-ink-dim">
          <span class="text-red">$</span> ./read-next
        </h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {readNext.map((guide) => (
            <a
              href={`${BASE}learn/${guide.id}/`}
              class="group flex flex-col gap-2 rounded-lg border border-edge bg-panel p-5 transition-colors hover:border-neon/60"
            >
              <span class={`inline-flex w-fit items-center rounded-full border px-2 py-0.5 text-xs ${levelStyles[guide.data.level] ?? levelStyles.beginner}`}>
                {guide.data.level}
              </span>
              <h3 class="font-display font-semibold leading-snug text-ink group-hover:text-neon">{guide.data.title}</h3>
              <p class="text-sm text-ink-dim line-clamp-2">{guide.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .article {
    color: var(--color-ink-dim);
    line-height: 1.8;
    font-size: 1rem;
  }
  .article :global(h2) {
    font-family: var(--font-display);
    color: var(--color-ink);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2.5rem 0 1rem;
  }
  .article :global(h2)::before {
    content: "$ ";
    color: var(--color-red);
    font-family: var(--font-mono);
  }
  .article :global(h3) {
    font-family: var(--font-display);
    color: var(--color-ink);
    font-size: 1.2rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
  }
  .article :global(p) {
    margin: 1rem 0;
  }
  .article :global(ul), .article :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }
  .article :global(ul) {
    list-style: disc;
  }
  .article :global(ol) {
    list-style: decimal;
  }
  .article :global(li) {
    margin: 0.4rem 0;
  }
  .article :global(code) {
    font-family: var(--font-mono);
    color: var(--color-neon);
    font-size: 0.9em;
  }
  .article :global(pre) {
    background: var(--color-night);
    border: 1px solid var(--color-edge);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1.25rem 0;
  }
  .article :global(pre code) {
    color: var(--color-ink);
  }
  .article :global(a) {
    color: var(--color-neon);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article :global(blockquote) {
    border-left: 3px solid var(--color-red);
    padding-left: 1rem;
    margin: 1.25rem 0;
    color: var(--color-ink-dim);
    font-style: italic;
  }
</style>
