---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { BASE } from "../../lib/site";

export async function getStaticPaths() {
  const posts = await getCollection("learn", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, level, tags, published } = post.data;

const levelStyles: Record<string, string> = {
  beginner: "text-neon border-neon/40",
  intermediate: "text-neon-bright border-neon/40",
  advanced: "text-red-bright border-red/40",
};
---

<BaseLayout title={title} description={description}>
  <article class="mx-auto max-w-3xl px-4 py-12 sm:px-6">
    <a href={`${BASE}learn/`} class="inline-flex items-center gap-1.5 text-sm text-ink-dim hover:text-neon">
      <Icon name="lucide:arrow-left" class="h-4 w-4" />
      All guides
    </a>

    <header class="mt-8">
      <div class="flex flex-wrap items-center gap-3">
        <span class={`inline-flex items-center rounded-full border px-2.5 py-0.5 text-xs ${levelStyles[level] ?? levelStyles.beginner}`}>
          {level}
        </span>
        <time class="font-mono text-xs text-ink-faint">
          {published.toLocaleDateString("en-ZA", { year: "numeric", month: "long", day: "numeric" })}
        </time>
      </div>
      <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-ink">{title}</h1>
      <p class="mt-3 text-lg text-ink-dim">{description}</p>
    </header>

    <div class="article mt-10">
      <Content />
    </div>

    {tags.length > 0 && (
      <div class="mt-12 flex flex-wrap gap-2 border-t border-edge pt-6">
        {tags.map((tag) => (
          <span class="rounded border border-edge bg-panel px-2 py-1 font-mono text-xs text-ink-faint">#{tag}</span>
        ))}
      </div>
    )}
  </article>
</BaseLayout>

<style>
  .article {
    color: var(--color-ink-dim);
    line-height: 1.8;
    font-size: 1rem;
  }
  .article :global(h2) {
    font-family: var(--font-display);
    color: var(--color-ink);
    font-size: 1.5rem;
    font-weight: 700;
    margin: 2.5rem 0 1rem;
  }
  .article :global(h2)::before {
    content: "$ ";
    color: var(--color-neon);
    font-family: var(--font-mono);
  }
  .article :global(h3) {
    font-family: var(--font-display);
    color: var(--color-ink);
    font-size: 1.2rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
  }
  .article :global(p) {
    margin: 1rem 0;
  }
  .article :global(ul), .article :global(ol) {
    margin: 1rem 0;
    padding-left: 1.5rem;
  }
  .article :global(ul) {
    list-style: disc;
  }
  .article :global(ol) {
    list-style: decimal;
  }
  .article :global(li) {
    margin: 0.4rem 0;
  }
  .article :global(code) {
    font-family: var(--font-mono);
    color: var(--color-neon);
    font-size: 0.9em;
  }
  .article :global(pre) {
    background: var(--color-night);
    border: 1px solid var(--color-edge);
    border-radius: 0.5rem;
    padding: 1rem 1.25rem;
    overflow-x: auto;
    margin: 1.25rem 0;
  }
  .article :global(pre code) {
    color: var(--color-ink);
  }
  .article :global(a) {
    color: var(--color-neon);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .article :global(blockquote) {
    border-left: 3px solid var(--color-red);
    padding-left: 1rem;
    margin: 1.25rem 0;
    color: var(--color-ink-dim);
    font-style: italic;
  }
</style>
