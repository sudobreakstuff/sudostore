---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import OrderButton from "../components/OrderButton.astro";
import { formatPrice } from "../lib/format";
import { SITE, contactLink } from "../lib/site";

const services = (await getCollection("products", ({ data }) => data.category === "software-services"))
  .sort((a, b) => a.data.title.localeCompare(b.data.title));

const steps = [
  { icon: "lucide:message-circle", title: "Tell me the problem", text: "Message me on WhatsApp or email with what you need — the more detail, the better the quote." },
  { icon: "lucide:wrench", title: "I build or fix it", text: "I scope it, build it, test it, and keep you in the loop the whole way." },
  { icon: "lucide:package-check", title: "You get it working", text: "Delivered configured and ready to use, with notes so you're never stuck." },
];
---

<BaseLayout
  title="Services"
  description="Custom automation, device setup, flashing and honest tech support — built in South Africa."
>
  <section class="grid-bg border-b border-edge">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <p class="font-mono text-sm text-neon-dim">
        <span class="text-red">~/</span>services<span class="cursor ml-1"></span>
      </p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">Services</h1>
      <p class="mt-4 max-w-2xl text-ink-dim">
        If it's repetitive, I automate it. If it doesn't exist, I build it. If
        it's broken, I fix it. That's the whole service catalogue.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-5 md:grid-cols-2">
      {services.map((s) => (
        <div class="flex flex-col rounded-lg border border-edge bg-panel p-6 transition-colors hover:border-neon/60">
          <div class="flex items-start justify-between gap-4">
            <div>
              <h2 class="font-display text-xl font-semibold text-ink">{s.data.title}</h2>
              <p class="mt-1 font-mono text-sm text-red">{formatPrice(s.data.price, s.data.priceNote)}</p>
            </div>
            <Icon name="lucide:terminal" class="h-5 w-5 shrink-0 text-neon-dim" />
          </div>
          <p class="mt-3 text-sm leading-relaxed text-ink-dim">{s.data.tagline}</p>
          {s.data.specs.length > 0 && (
            <ul class="mt-4 space-y-1.5">
              {s.data.specs.map((spec) => (
                <li class="flex items-start gap-2 text-sm text-ink-dim">
                  <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-neon" />
                  {spec}
                </li>
              ))}
            </ul>
          )}
          <div class="mt-5 border-t border-edge pt-5">
            <OrderButton product={s.data.title} variant="outline" />
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="border-y border-edge bg-night/50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="font-mono text-sm uppercase tracking-widest text-ink-dim">
        <span class="text-red">$</span> ./how-it-works
      </h2>
      <div class="mt-8 grid gap-8 md:grid-cols-3">
        {steps.map((step, i) => (
          <div class="flex flex-col gap-3">
            <span class="inline-flex h-11 w-11 items-center justify-center rounded-md border border-edge bg-panel text-neon">
              <Icon name={step.icon} class="h-5 w-5" />
            </span>
            <p class="font-mono text-xs text-ink-faint">0{i + 1}</p>
            <h3 class="font-display font-semibold text-ink">{step.title}</h3>
            <p class="text-sm leading-relaxed text-ink-dim">{step.text}</p>
          </div>
        ))}
      </div>
      <div class="mt-12 flex flex-wrap items-center gap-4">
        <a
          href={contactLink()}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 rounded bg-neon px-6 py-3 text-sm font-semibold text-void transition-colors hover:bg-neon-bright"
        >
          <Icon name="lucide:message-circle" class="h-4 w-4" />
          Start a conversation
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="inline-flex items-center gap-2 text-sm text-ink-dim hover:text-neon"
        >
          <Icon name="lucide:mail" class="h-4 w-4" />
          {SITE.email}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
