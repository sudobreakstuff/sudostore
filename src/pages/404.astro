---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import { BASE } from "../lib/site";
---

<BaseLayout title="404">
  <section class="grid-bg flex min-h-[60vh] items-center">
    <div class="mx-auto max-w-6xl px-4 py-20 text-center sm:px-6">
      <p class="font-mono text-sm text-ink-faint">error 404 — not found</p>
      <h1 class="mt-4 font-mono text-5xl font-bold text-neon glow sm:text-7xl">404</h1>
      <p class="mt-4 max-w-md mx-auto text-ink-dim">
        This page doesn't exist. Maybe it moved, maybe it was never built, maybe
        the terminal ate it.
      </p>
      <div class="mt-8 flex flex-wrap justify-center gap-4">
        <a href={BASE} class="inline-flex items-center gap-2 rounded bg-neon px-6 py-3 text-sm font-semibold text-void transition-colors hover:bg-neon-bright">
          <Icon name="lucide:home" class="h-4 w-4" />
          Back home
        </a>
        <a href={`${BASE}store/`} class="inline-flex items-center gap-2 rounded border border-edge px-6 py-3 text-sm font-semibold text-ink-dim transition-colors hover:border-neon hover:text-neon">
          <Icon name="lucide:shopping-bag" class="h-4 w-4" />
          Browse the store
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
