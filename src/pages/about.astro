---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../lib/site";

const values = [
  { icon: "lucide:flame", title: "Built from problems", text: "Every product starts with 'this shouldn't be this hard' and ends with something that works." },
  { icon: "lucide:lock-open", title: "Open by default", text: "Open source isn't a license to me — it's a philosophy. Tools that solve real problems shouldn't be paywalled." },
  { icon: "lucide:wallet", title: "Fair prices", text: "No middlemen, no markup for the sake of it. Cool tech should be affordable." },
  { icon: "lucide:graduation-cap", title: "Teach as I go", text: "If I can build it, I can show you how. The Learn section exists so nothing stays a secret." },
];
---

<BaseLayout
  title="About"
  description="Who runs sudostore and why — built in Newcastle, South Africa, on open source and fair prices."
>
  <section class="grid-bg border-b border-edge">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <p class="font-mono text-sm text-neon-dim">
        <span class="text-red">~/</span>about<span class="cursor ml-1"></span>
      </p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        Hey, I'm Shahid.
      </h1>
      <p class="mt-4 max-w-2xl text-ink-dim">
        Systems developer, automation engineer and tinkerer from {SITE.location}.
        sudostore is where I put the things I build out into the world.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-5 text-ink-dim leading-relaxed">
        <p>
          I build systems that make other systems work better. At Jenny Internet
          I design internal software — ticket workflows, browser extensions,
          file-management tools — that keep support teams running smoothly.
        </p>
        <p>
          But the best stuff happens outside a job description. Screenshots are
          a pain, so I built an extension. A bakery can't afford a POS, so I
          built SpiceDesk and open-sourced it. Macro keyboards cost too much,
          so I designed my own and now I sell it. Every project starts with
          <span class="text-ink">"this shouldn't be this hard"</span> and ends
          with code anyone can use.
        </p>
        <p>
          sudostore is the shopfront for all of it: handhelds running SudoOS,
          card readers that actually read and write, custom hardware, 3D-printed
          gear and the software in between — plus a place to learn how it's all
          made.
        </p>
        <p class="font-mono text-sm text-neon">
          If it's repetitive, I automate it. If it doesn't exist, I build it.
        </p>
      </div>

      <aside class="space-y-3">
        <a href={SITE.portfolio} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-lg border border-edge bg-panel p-4 transition-colors hover:border-neon/60">
          <Icon name="lucide:user" class="h-5 w-5 text-neon" />
          <span>
            <span class="block text-sm font-semibold text-ink">Full portfolio</span>
            <span class="block text-xs text-ink-faint">Experience, skills and resume</span>
          </span>
        </a>
        <a href={SITE.github} target="_blank" rel="noopener" class="flex items-center gap-3 rounded-lg border border-edge bg-panel p-4 transition-colors hover:border-neon/60">
          <Icon name="lucide:github" class="h-5 w-5 text-neon" />
          <span>
            <span class="block text-sm font-semibold text-ink">GitHub</span>
            <span class="block text-xs text-ink-faint">All the source code</span>
          </span>
        </a>
      </aside>
    </div>
  </section>

  <section class="border-t border-edge bg-night/50">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <h2 class="font-mono text-sm uppercase tracking-widest text-ink-dim">
        <span class="text-neon">$</span> cat values
      </h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {values.map((v) => (
          <div class="rounded-lg border border-edge bg-panel p-5">
            <Icon name={v.icon} class="h-6 w-6 text-neon" />
            <h3 class="mt-3 font-display font-semibold text-ink">{v.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-dim">{v.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
