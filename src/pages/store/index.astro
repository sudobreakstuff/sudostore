---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import SearchInput from "../../components/SearchInput.astro";
import { CATEGORIES } from "../../lib/catalog";

const products = (await getCollection("products")).sort((a, b) => {
  if (a.data.featured !== b.data.featured) return a.data.featured ? -1 : 1;
  return a.data.title.localeCompare(b.data.title);
});

const grouped = CATEGORIES.map((cat) => ({
  ...cat,
  items: products.filter((p) => p.data.category === cat.id),
})).filter((cat) => cat.items.length > 0);
---

<BaseLayout
  title="Store"
  description="Handheld consoles, card readers, custom hardware, 3D-printed gear and software — sold at fair prices."
>
  <section class="grid-bg border-b border-edge">
    <div class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
      <p class="font-mono text-sm text-neon-dim">
        <span class="text-red">~/</span>store<span class="cursor ml-1"></span>
      </p>
      <h1 class="mt-3 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
        The store
      </h1>
      <p class="mt-4 max-w-2xl text-ink-dim">
        Everything here is built, flashed or configured by hand. Prices are
        fair because there's no middleman — just me and a soldering iron.
      </p>
    </div>
  </section>

  <div class="sticky top-16 z-40 border-b border-edge bg-void/85 backdrop-blur-md">
    <div class="mx-auto max-w-6xl px-4 py-3 sm:px-6">
      <SearchInput id="store-search" placeholder="Search products…" />
      <div class="mt-3 flex gap-2 overflow-x-auto" id="filter-bar">
        <button
          data-filter="all"
          class="filter-btn shrink-0 rounded border border-neon bg-neon/15 px-4 py-1.5 text-sm font-semibold text-neon"
        >
          All
        </button>
        {grouped.map((cat) => (
          <button
            data-filter={cat.id}
            class="filter-btn shrink-0 rounded border border-edge px-4 py-1.5 text-sm text-ink-dim transition-colors hover:border-neon/50 hover:text-neon"
          >
            {cat.label}
          </button>
        ))}
      </div>
    </div>
  </div>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div id="store-no-results" class="hidden rounded-lg border border-edge bg-panel p-10 text-center">
      <p class="font-mono text-sm text-ink-dim">$ ./search --no-results <span class="cursor"></span></p>
      <p class="mt-2 text-sm text-ink-faint">No products match that search. Try another term.</p>
    </div>

    {grouped.map((cat) => (
      <div data-section={cat.id} class="mb-14">
        <div class="mb-6 flex items-center gap-3">
          <span class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-edge bg-panel text-red">
            <Icon name={cat.icon} class="h-4 w-4" />
          </span>
          <div>
            <h2 id={cat.id} class="font-display text-xl font-semibold text-ink">{cat.label}</h2>
            <p class="text-sm text-ink-dim">{cat.blurb}</p>
          </div>
        </div>
        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {cat.items.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    ))}
  </section>
</BaseLayout>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".filter-btn");
  const sections = document.querySelectorAll<HTMLElement>("[data-section]");
  const search = document.getElementById("store-search");
  const noResults = document.getElementById("store-no-results");
  let activeFilter = "all";

  const activeClass = "filter-btn shrink-0 rounded border border-neon bg-neon/15 px-4 py-1.5 text-sm font-semibold text-neon";
  const idleClass = "filter-btn shrink-0 rounded border border-edge px-4 py-1.5 text-sm text-ink-dim transition-colors hover:border-neon/50 hover:text-neon";

  function matchesQuery(card): boolean {
    if (!search) return true;
    const q = search.value.trim().toLowerCase();
    if (!q) return true;
    return (card.dataset.search ?? "").includes(q);
  }

  function apply(): void {
    let anyVisible = false;
    sections.forEach((s) => {
      const sectionOk = activeFilter === "all" || s.dataset.section === activeFilter;
      const cards = s.querySelectorAll<HTMLElement>("[data-search]");
      let sectionHasMatches = false;
      cards.forEach((c) => {
        const show = sectionOk && matchesQuery(c);
        c.style.display = show ? "" : "none";
        if (show) sectionHasMatches = true;
      });
      s.style.display = sectionOk && sectionHasMatches ? "" : "none";
      if (sectionOk && sectionHasMatches) anyVisible = true;
    });
    if (noResults) noResults.classList.toggle("hidden", anyVisible);
  }

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      activeFilter = btn.dataset.filter;
      buttons.forEach((b) => {
        b.className = b.dataset.filter === activeFilter ? activeClass : idleClass;
      });
      apply();
    });
  });

  search?.addEventListener("input", apply);
</script>
