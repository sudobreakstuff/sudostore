---
import { getCollection, render } from "astro:content";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import OrderButton from "../../components/OrderButton.astro";
import ProductCard from "../../components/ProductCard.astro";
import { categoryIcon, categoryLabel } from "../../lib/catalog";
import { formatPrice } from "../../lib/format";
import { BASE } from "../../lib/site";

export async function getStaticPaths() {
  const products = await getCollection("products");
  return products.map((product) => ({
    params: { slug: product.id },
    props: { product },
  }));
}

const { product } = Astro.props;
const { title, tagline, description, price, priceNote, category, status, specs, tags, images = [] } = product.data;
const { Content } = await render(product);
const heroImage = images[0];
const gallery = images.slice(1);

const related = (await getCollection("products", ({ data }) => data.category === category))
  .filter((p) => p.id !== product.id)
  .slice(0, 3);

const statusStyles: Record<string, string> = {
  "in-stock": "text-neon border-neon/40",
  "made-to-order": "text-neon-bright border-neon/40",
  "pre-order": "text-red-bright border-red/40",
  "sold-out": "text-ink-faint border-edge",
};
---

<BaseLayout title={title} description={tagline}>
  <article class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <a href={`${BASE}store/`} class="inline-flex items-center gap-1.5 text-sm text-ink-dim hover:text-neon">
      <Icon name="lucide:arrow-left" class="h-4 w-4" />
      Back to store
    </a>

    <div class="mt-8 grid gap-10 lg:grid-cols-3">
      <!-- Main -->
      <div class="lg:col-span-2">
        {heroImage ? (
          <Image
            src={heroImage}
            alt={title}
            class="aspect-[16/10] w-full rounded-lg border border-edge object-cover"
          />
        ) : (
          <div class="flex aspect-[16/10] w-full items-center justify-center rounded-lg border border-edge bg-night">
            <Icon name={categoryIcon(category)} class="h-16 w-16 text-edge-bright" />
          </div>
        )}

        {gallery.length > 0 && (
          <div class="mt-3 grid grid-cols-3 gap-3">
            {gallery.map((img) => (
              <Image
                src={img}
                alt={`${title} — photo`}
                loading="lazy"
                class="aspect-[4/3] w-full rounded-lg border border-edge object-cover"
              />
            ))}
          </div>
        )}

        <div class="mt-6 flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-1.5 text-sm text-ink-dim">
            <Icon name={categoryIcon(category)} class="h-4 w-4 text-neon-dim" />
            {categoryLabel(category)}
          </span>
          <span class={`inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-xs ${statusStyles[status] ?? statusStyles["in-stock"]}`}>
            <span class="h-1.5 w-1.5 rounded-full bg-current pulse-soft"></span>
            {status === "made-to-order" ? "Made to order" : status === "pre-order" ? "Pre-order" : status === "sold-out" ? "Sold out" : "In stock"}
          </span>
        </div>

        <h1 class="mt-4 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">{title}</h1>
        <p class="mt-3 text-lg text-neon glow">{tagline}</p>

        <div class="mt-8 space-y-4 text-ink-dim leading-relaxed">
          {description.split("\n\n").map((para) => <p>{para}</p>)}
        </div>

        <div class="prose-invert mt-8 [&_code]:text-neon [&_h2]:font-display [&_h2]:text-ink [&_a]:text-neon">
          <Content />
        </div>

        {specs.length > 0 && (
          <div class="mt-10">
            <h2 class="font-mono text-sm uppercase tracking-widest text-ink-dim">
              <span class="text-red">$</span> cat specs
            </h2>
            <ul class="mt-4 grid gap-2 sm:grid-cols-2">
              {specs.map((spec) => (
                <li class="flex items-start gap-2 text-sm text-ink-dim">
                  <Icon name="lucide:check" class="mt-0.5 h-4 w-4 shrink-0 text-neon" />
                  {spec}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <aside>
        <div class="sticky top-24 rounded-lg border border-edge bg-panel p-6">
          <p class="font-mono text-xs uppercase tracking-widest text-ink-faint">Price</p>
          <p class="mt-2 font-mono text-3xl font-bold text-red glow-red">{formatPrice(price, priceNote)}</p>

          <div class="mt-6 space-y-3">
            <OrderButton product={`${title} (${tagline})`} class="w-full" />
            <a
              href={`mailto:sudobreakstuff1zn@gmail.com?subject=${encodeURIComponent(`Order: ${title}`)}`}
              class="inline-flex w-full items-center justify-center gap-2 rounded border border-edge px-5 py-2.5 text-sm font-semibold text-ink-dim transition-colors hover:border-neon hover:text-neon"
            >
              <Icon name="lucide:mail" class="h-4 w-4" />
              Email instead
            </a>
          </div>

          {tags.length > 0 && (
            <div class="mt-6 flex flex-wrap gap-2 border-t border-edge pt-5">
              {tags.map((tag) => (
                <span class="rounded border border-edge bg-night px-2 py-1 font-mono text-xs text-ink-faint">#{tag}</span>
              ))}
            </div>
          )}
        </div>
      </aside>
    </div>

    {related.length > 0 && (
      <div class="mt-16 border-t border-edge pt-12">
        <h2 class="font-mono text-sm uppercase tracking-widest text-ink-dim">
          <span class="text-red">$</span> ./related
        </h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {related.map((p) => <ProductCard product={p} />)}
        </div>
      </div>
    )}
  </article>
</BaseLayout>
