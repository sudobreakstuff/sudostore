---
interface Props {
  kicker?: string;
  title: string;
  description?: string;
  align?: "left" | "center";
}

const { kicker, title, description, align = "left" } = Astro.props;
const alignment = align === "center" ? "items-center text-center" : "items-start text-left";
---

<div class={`flex flex-col ${alignment}`}>
  {kicker && (
    <p class="font-mono text-sm text-neon-dim">
      <span class="text-red">~/</span>{kicker}
      <span class="cursor ml-1"></span>
    </p>
  )}
  <h1 class="mt-3 font-display text-3xl font-bold tracking-tight text-ink sm:text-4xl md:text-5xl">
    {title}
  </h1>
  {description && (
    <p class="mt-4 max-w-2xl text-base leading-relaxed text-ink-dim">
      {description}
    </p>
  )}
</div>
