---
import { Icon } from "astro-icon/components";
import type { CollectionEntry } from "astro:content";
import { categoryIcon, categoryLabel } from "../lib/catalog";
import { formatPrice } from "../lib/format";

interface Props {
  product: CollectionEntry<"products">;
}

const { product } = Astro.props;
const { title, tagline, price, priceNote, category, status } = product.data;

const statusStyles: Record<string, string> = {
  "in-stock": "text-phosphor border-phosphor/40",
  "made-to-order": "text-phosphor-bright border-phosphor/40",
  "pre-order": "text-poke-bright border-poke/40",
  "sold-out": "text-ink-faint border-edge",
};
---

<a
  href={`/store/${product.id}/`}
  class="group relative flex flex-col overflow-hidden rounded-lg border border-edge bg-panel transition-all hover:-translate-y-0.5 hover:border-phosphor/60"
>
  <div class="flex items-center justify-between border-b border-edge px-4 py-3">
    <span class="inline-flex items-center gap-1.5 text-xs text-ink-dim">
      <Icon name={categoryIcon(category)} class="h-3.5 w-3.5 text-phosphor-dim" />
      {categoryLabel(category)}
    </span>
    <span class={`inline-flex items-center gap-1.5 rounded-full border px-2 py-0.5 text-[11px] ${statusStyles[status] ?? statusStyles["in-stock"]}`}>
      <span class="h-1.5 w-1.5 rounded-full bg-current pulse-soft"></span>
      {status === "made-to-order" ? "Made to order" : status === "pre-order" ? "Pre-order" : status === "sold-out" ? "Sold out" : "In stock"}
    </span>
  </div>

  <div class="flex flex-1 flex-col gap-2 p-4">
    <h3 class="font-display text-lg font-semibold leading-tight text-ink group-hover:text-phosphor transition-colors">
      {title}
    </h3>
    <p class="text-sm leading-relaxed text-ink-dim line-clamp-2">{tagline}</p>
  </div>

  <div class="flex items-center justify-between border-t border-edge px-4 py-3">
    <span class="font-mono text-lg font-bold text-phosphor">
      {formatPrice(price, priceNote)}
    </span>
    <span class="inline-flex items-center gap-1 text-xs text-ink-faint transition-colors group-hover:text-phosphor">
      View
      <Icon name="lucide:arrow-right" class="h-3.5 w-3.5" />
    </span>
  </div>
</a>
