---
import { Icon } from "astro-icon/components";
import Logo from "./Logo.astro";
import { SITE, BASE, contactLink } from "../lib/site";

const year = new Date().getFullYear();
---

<footer class="relative z-10 border-t border-edge bg-night">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-14 sm:px-6 md:grid-cols-5">
    <div class="md:col-span-2">
      <Logo />
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-ink-dim">
        {SITE.tagline} Handhelds, card readers, custom hardware and software —
        built in {SITE.location}.
      </p>
      <div class="mt-5 flex items-center gap-3">
        <a
          href={SITE.github}
          target="_blank"
          rel="noopener"
          class="inline-flex h-9 w-9 items-center justify-center rounded border border-edge text-ink-dim transition-colors hover:border-neon hover:text-neon"
          aria-label="GitHub"
        >
          <Icon name="lucide:github" class="h-4 w-4" />
        </a>
        <a
          href={contactLink()}
          target="_blank"
          rel="noopener"
          class="inline-flex h-9 w-9 items-center justify-center rounded border border-edge text-ink-dim transition-colors hover:border-red hover:text-red-bright"
          aria-label="WhatsApp"
        >
          <Icon name="lucide:message-circle" class="h-4 w-4" />
        </a>
        <a
          href={`mailto:${SITE.email}`}
          class="inline-flex h-9 w-9 items-center justify-center rounded border border-edge text-ink-dim transition-colors hover:border-neon hover:text-neon"
          aria-label="Email"
        >
          <Icon name="lucide:mail" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <nav aria-label="Footer">
      <h3 class="font-mono text-xs uppercase tracking-widest text-ink-faint">Explore</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a class="text-ink-dim hover:text-neon" href={`${BASE}store/`}>Store</a></li>
        <li><a class="text-ink-dim hover:text-neon" href={`${BASE}services/`}>Services</a></li>
        <li><a class="text-ink-dim hover:text-neon" href={`${BASE}projects/`}>Projects</a></li>
        <li><a class="text-ink-dim hover:text-neon" href={`${BASE}learn/`}>Learn</a></li>
      </ul>
    </nav>

    <nav aria-label="Company">
      <h3 class="font-mono text-xs uppercase tracking-widest text-ink-faint">Company</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a class="text-ink-dim hover:text-neon" href={`${BASE}about/`}>About</a></li>
        <li><a class="text-ink-dim hover:text-neon" href={`${BASE}contact/`}>Contact</a></li>
        <li><a class="text-ink-dim hover:text-neon" href={SITE.portfolio} target="_blank" rel="noopener">Portfolio</a></li>
      </ul>
    </nav>

    <nav aria-label="Legal">
      <h3 class="font-mono text-xs uppercase tracking-widest text-ink-faint">Legal</h3>
      <ul class="mt-4 space-y-2 text-sm">
        <li><a class="text-ink-dim hover:text-neon" href={`${BASE}privacy/`}>Privacy Policy</a></li>
        <li><a class="text-ink-dim hover:text-neon" href={`${BASE}terms/`}>Terms</a></li>
        <li><a class="text-ink-dim hover:text-neon" href={`${BASE}shipping/`}>Shipping</a></li>
        <li><a class="text-ink-dim hover:text-neon" href={`${BASE}returns/`}>Returns</a></li>
      </ul>
    </nav>
  </div>

  <div class="border-t border-edge">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-4 py-6 text-xs text-ink-faint sm:flex-row sm:items-center sm:justify-between sm:px-6">
      <p>© {year} {SITE.name}. Built with <Icon name="lucide:terminal" class="inline h-3.5 w-3.5 text-neon" /> in South Africa.</p>
      <p class="font-mono"><span class="text-red">$</span> ./keep-hacking</p>
    </div>
  </div>
</footer>
