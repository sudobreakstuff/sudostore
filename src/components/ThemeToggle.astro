---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  class={`inline-flex h-10 w-10 items-center justify-center rounded border border-edge text-ink transition-colors hover:border-red hover:text-red ${className ?? ""}`}
  aria-label="Toggle light and dark mode"
  title="Toggle light and dark mode"
>
  <svg viewBox="0 0 24 24" class="h-5 w-5" aria-hidden="true">
    <circle cx="12" cy="12" r="10.6" fill="#f4f6fb" />
    <path d="M1.4 12a10.6 10.6 0 0 1 21.2 0Z" fill="#dd1010" />
    <rect x="1.4" y="10.8" width="21.2" height="2.4" fill="#16202f" />
    <circle cx="12" cy="12" r="3" fill="#f4f6fb" stroke="#16202f" stroke-width="1.8" />
  </svg>
</button>
