---
interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 100 100"
  fill="none"
  aria-hidden="true"
>
  <circle cx="50" cy="50" r="49" stroke="currentColor" stroke-width="1.5" opacity="0.7" />
  <path d="M1 50a49 49 0 0 1 98 0Z" fill="currentColor" opacity="0.14" />
  <line x1="1" y1="50" x2="99" y2="50" stroke="currentColor" stroke-width="3" opacity="0.7" />
  <circle cx="50" cy="50" r="12" stroke="currentColor" stroke-width="3" fill="var(--color-void)" opacity="0.9" />
</svg>
