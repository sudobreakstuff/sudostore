---
import { Icon } from "astro-icon/components";
import Logo from "./Logo.astro";
import ThemeToggle from "./ThemeToggle.astro";
import { BASE, contactLink } from "../lib/site";

const nav = [
  { label: "Store", href: `${BASE}store/` },
  { label: "Services", href: `${BASE}services/` },
  { label: "Projects", href: `${BASE}projects/` },
  { label: "Learn", href: `${BASE}learn/` },
  { label: "About", href: `${BASE}about/` },
];
---

<header class="sticky top-0 z-50 border-b border-edge bg-void/85 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-4 sm:px-6">
    <Logo />

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {nav.map((item) => (
        <a
          href={item.href}
          class="rounded px-3 py-2 text-sm text-ink-dim transition-colors hover:text-neon"
        >
          <span class="text-neon-dim">/</span>{item.label.toLowerCase()}
        </a>
      ))}
      <a
        href={contactLink()}
        target="_blank"
        rel="noopener"
        class="ml-3 inline-flex items-center gap-2 rounded border border-red bg-red/10 px-4 py-2 text-sm font-semibold text-red-bright transition-colors hover:bg-red hover:text-void"
      >
        <Icon name="lucide:message-circle" class="h-4 w-4" />
        Order now
      </a>
      <ThemeToggle class="ml-2" />
    </nav>

    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <button
        id="menu-toggle"
        class="inline-flex h-10 w-10 items-center justify-center rounded border border-edge text-ink"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <Icon name="lucide:menu" class="h-5 w-5" />
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden border-t border-edge bg-night md:hidden">
    <nav class="flex flex-col px-4 py-3" aria-label="Mobile">
      {nav.map((item) => (
        <a
          href={item.href}
          class="rounded px-3 py-3 text-ink-dim transition-colors hover:bg-panel hover:text-neon"
        >
          <span class="text-neon-dim">/</span>{item.label.toLowerCase()}
        </a>
      ))}
      <a
        href={contactLink()}
        target="_blank"
        rel="noopener"
        class="mt-2 mb-2 inline-flex items-center justify-center gap-2 rounded border border-red bg-red/10 px-4 py-3 text-red-bright"
      >
        <Icon name="lucide:message-circle" class="h-4 w-4" />
        Order now
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });

  document.querySelectorAll<HTMLButtonElement>("[data-theme-toggle]").forEach((btn) => {
    btn.addEventListener("click", () => {
      const root = document.documentElement;
      const isLight = root.getAttribute("data-theme") === "light";
      if (isLight) {
        root.removeAttribute("data-theme");
        localStorage.setItem("sudostore-theme", "dark");
      } else {
        root.setAttribute("data-theme", "light");
        localStorage.setItem("sudostore-theme", "light");
      }
    });
  });
</script>
